---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---
<Base title="Страница не найдена" description="Такой страницы нет. Вернитесь на главную или позвоните нам." noindex>
  <section class="section">
    <div class="container" style="max-width:720px;text-align:center">
      <p class="eyebrow">Ошибка 404</p>
      <h1>Страница не найдена</h1>
      <p class="lead" style="margin-inline:auto">Возможно, адрес изменился. Перейдите на главную или в нужный раздел.</p>
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;margin-top:2rem">
        <Button href="/">На главную</Button>
        <Button href="/okna/alyuminievye/" variant="outline">Алюминиевые окна</Button>
        <Button href="/okna/pvh/" variant="outline">Окна ПВХ</Button>
      </div>
    </div>
  </section>
</Base>
