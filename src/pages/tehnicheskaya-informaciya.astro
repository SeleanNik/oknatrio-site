---
// Техническая информация: два каталога (Alutech, Schuco) — просмотр PDF на странице и скачивание.
// Данные и пути к PDF — src/config/tech.mjs, файлы — public/docs/.
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { techCatalogs, vekaProfiles, vekaSection, vekaFiles } from '../config/tech.mjs';
import { pagesData } from '../config/pages.mjs';
---
<Base
  title="Техническая информация: каталоги Alutech, Schuco и профили VEKA"
  description="Технические каталоги алюминиевых систем Alutech и Schuco, профили VEKA: просмотр на странице и скачивание в PDF."
>
  <Breadcrumbs items={[{ title: 'Техническая информация' }]} />

  <section class="head">
    <div class="container">
      <h1>Техническая информация</h1>
      <p class="lead" data-ed="tech.lead">{pagesData.tech?.lead}</p>
      <nav class="chips" aria-label="Каталоги">
        {[...techCatalogs, vekaSection].map((c, i) => <a href={`#${c.id}`}><b>{i + 1}</b>{c.title}</a>)}
      </nav>
    </div>
  </section>

  {techCatalogs.map((c, i) => (
    <section class="cat" id={c.id}>
      <div class="container">
        <div class="banner">
          <div class="banner__text">
            <span class="cat__num">{i + 1}</span>
            <h2>{c.title.replace(c.brand, '').trim()}<span class="sr-only"> {c.brand}</span></h2>
            <p data-ed={`tech.${c.id}.text`}>{c.text}</p>
          </div>
          <span class="banner__brand" aria-hidden="true">{c.brand}</span>
        </div>
        <ul class="files" id={`${c.id}-files`} data-ed-files={`tech.${c.id}.files`}>
          {c.files.map((f) => (
            <li class="file">
              <span class="file__ico"><Icon name="file" size={22} /></span>
              <span class="file__name"><b>{f.title}</b><small>PDF · {f.size}</small></span>
              <span class="file__btns">
                <Button href={f.pdf} target="_blank" rel="noopener" variant="outline" size="sm">Открыть</Button>
                <Button href={f.pdf} download size="sm">Скачать</Button>
              </span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="cat veka" id={vekaSection.id} aria-labelledby="veka-title">
    <div class="container">
      <div class="banner">
        <div class="banner__text">
          <span class="cat__num">{techCatalogs.length + 1}</span>
          <h2 id="veka-title">{vekaSection.title.replace(vekaSection.brand, '').trim()}<span class="sr-only"> {vekaSection.brand}</span></h2>
          <p data-ed="tech.veka.text">{vekaSection.text}</p>
        </div>
        <span class="banner__brand" aria-hidden="true">{vekaSection.brand}</span>
      </div>
      <ul class="vgrid">
        {vekaProfiles.map((p) => (
          <li class="vcard" id={p.id} data-ed-profile={vekaProfiles.indexOf(p)}>
            <span class="vcard__tag">{p.tag}</span>
            <div class="vcard__img"><img src={p.src} alt={`Профиль VEKA ${p.name} в разрезе`} width={p.w} height={p.h} loading="lazy" decoding="async" /></div>
            <h3>{p.name}</h3>
            <p>{p.text}</p>
            <ul class="vcard__specs">{p.specs.map((s) => <li><Icon name="check" size={16} />{s}</li>)}</ul>
          </li>
        ))}
      </ul>
      <h3 class="files__title">Каталоги VEKA</h3>
      <ul class="files" data-ed-files="tech.veka.files">
        {vekaFiles.map((f) => (
          <li class="file">
            <span class="file__ico"><Icon name="file" size={22} /></span>
            <span class="file__name"><b>{f.title}</b><small>PDF · {f.size}</small></span>
            <span class="file__btns">
              <Button href={f.pdf} target="_blank" rel="noopener" variant="outline" size="sm">Открыть</Button>
              <Button href={f.pdf} download size="sm">Скачать</Button>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="cta">
    <div class="container cta__in">
      <div><h2>Нужна консультация по системам?</h2><p>Подскажем систему и комплектацию под ваш объект.</p></div>
      <Button href="/#zayavka" size="lg">Оставить заявку</Button>
    </div>
  </section>
</Base>

<style>
  .head { padding-bottom: var(--sp-5); }
  .head h1 { margin-bottom: .3em; }
  .head .lead { font-size: var(--fs-md); margin-bottom: var(--sp-4); }
  .chips { display: flex; flex-wrap: wrap; gap: var(--sp-2); }
  .chips a { display: inline-flex; align-items: center; gap: .55rem; padding: .4rem 1rem .4rem .45rem; border-radius: var(--r-pill); background: var(--c-surface); border: 1px solid var(--c-line); color: var(--c-navy-800); text-decoration: none; font: 600 var(--fs-sm)/1.2 var(--font-head); }
  .chips b { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--c-amber-500); color: #fff; font-size: .75rem; }
  .chips a:hover { border-color: var(--c-amber-500); }

  .cat { padding-block: var(--section-y); border-top: 1px solid var(--c-line); scroll-margin-top: var(--header-h); }
  .cat:nth-of-type(odd) { background: var(--c-surface); }
  .cat__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--sp-3) var(--sp-5); margin-bottom: var(--sp-4); }
  .cat__num { display: inline-grid; place-items: center; width: 32px; height: 32px; margin-bottom: .6rem; border-radius: 50%; background: var(--c-amber-500); color: #fff; font: 800 .9rem/1 var(--font-head); }
  .cat__head h2 { margin-bottom: .25em; }
  .cat__head p { margin: 0; color: var(--c-text-muted); font-size: var(--fs-sm); max-width: 62ch; }
  .cat__btns { display: flex; gap: var(--sp-2); flex-wrap: wrap; }

  .banner { position: relative; display: grid; grid-template-columns: 1fr; align-items: center; gap: var(--sp-3); margin-bottom: var(--sp-4); padding: var(--sp-5) var(--sp-4); border-radius: 22px; overflow: hidden; color: #fff; background: #0b1017; }
  .banner__text { position: relative; z-index: 1; display: grid; justify-items: start; gap: var(--sp-3); padding-bottom: var(--sp-2); }
  .banner h2 { margin: 0; color: #fff; text-transform: uppercase; letter-spacing: .01em; font-size: clamp(1.4rem, 1rem + 1.6vw, 2.1rem); line-height: 1.15; }
  .banner p { margin: 0; max-width: 46ch; color: var(--c-on-dark-muted); font-size: var(--fs-sm); }
  .banner .cat__num { margin: 0; }
  /* крупное название бренда в шапке раздела */
  .banner__brand { position: relative; z-index: 1; justify-self: start; font: 800 clamp(2.6rem, 1.6rem + 5vw, 6rem)/1 var(--font-head); letter-spacing: .02em; text-transform: uppercase; background: linear-gradient(120deg, #fff 30%, #8da9ff); -webkit-background-clip: text; background-clip: text; color: transparent; }
  @media (min-width: 800px) {
    .banner { grid-template-columns: 1fr auto; min-height: 0; padding: 0 var(--sp-6); }
    .banner__brand { justify-self: end; }
    .banner__text { padding-block: var(--sp-5); }
  }

  .vgrid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-3); grid-template-columns: 1fr; }
  .vcard { position: relative; display: flex; flex-direction: column; gap: .5rem; padding: var(--sp-4); border-radius: 22px; background: #fff; border: 1px solid var(--c-line); transition: border-color .2s; }
  .vcard:hover { border-color: var(--c-amber-500); }
  .vcard__tag { position: absolute; top: var(--sp-3); left: var(--sp-3); z-index: 1; padding: .3rem .8rem; border-radius: var(--r-pill); background: var(--c-blue-50); color: var(--c-blue-600); font: 700 var(--fs-xs)/1 var(--font-head); }
  .vcard__img { display: grid; place-items: center; aspect-ratio: 1; margin: 0 0 .5rem; border-radius: 16px; background: radial-gradient(circle at 50% 42%, #2b3a52 0%, #141b27 70%); }
  .vcard__img img { width: 82%; height: auto; transition: transform .5s var(--ease); }
  .vcard:hover .vcard__img img { transform: scale(1.04); }
  .vcard h3 { margin: 0; font-size: var(--fs-lg); }
  .vcard p { margin: 0; color: var(--c-text-muted); font-size: var(--fs-sm); }
  .vcard__specs { list-style: none; margin: var(--sp-2) 0 0; padding: var(--sp-3) 0 0; border-top: 1px solid var(--c-line); display: grid; gap: .45rem; font: 600 var(--fs-sm)/1.3 var(--font-head); color: var(--c-navy-800); }
  .vcard__specs li { display: flex; align-items: center; gap: .5rem; }
  .vcard__specs :global(svg) { color: var(--c-amber-500); flex: none; }
  @media (min-width: 800px) { .vgrid { grid-template-columns: repeat(3, 1fr); } }

  .files__title { margin: var(--sp-7) 0 var(--sp-3); font: 700 var(--fs-lg)/1.2 var(--font-head); color: var(--c-navy-900); display: flex; align-items: center; gap: .6rem; }
  .files__title::after { content: ''; flex: 1; height: 1px; background: var(--c-line); }
  .files { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-2); }
  .file { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-2) var(--sp-3); padding: var(--sp-3); border-radius: 18px; background: #fff; border: 1px solid var(--c-line); }
  .file__ico { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: var(--c-blue-50); color: var(--c-blue-600); flex: none; }
  .file__name { display: grid; gap: .15rem; flex: 1 1 200px; min-width: 0; }
  .file__name b { font: 700 var(--fs-md)/1.25 var(--font-head); color: var(--c-navy-800); }
  .file__name small { color: var(--c-text-muted); font-size: var(--fs-xs); }
  .file__btns { display: flex; gap: var(--sp-2); }

  .cta { background: var(--c-navy-800); color: #fff; padding-block: var(--section-y); }
  .cta h2 { color: #fff; margin-bottom: .2em; }
  .cta p { margin: 0; color: var(--c-on-dark-muted); }
  .cta__in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--sp-4); }
</style>
