---
import Button from '../Button.astro';
import { pagesData } from '../../config/pages.mjs';
const hero = pagesData.home.hero;
const heroStats = pagesData.home.heroStats ?? [];

// Главный экран (референс клиента: фото дома на весь экран, стеклянная карточка справа внизу).
// Заголовок строго в 2 строки. TODO: итоговое фото дома с окнами от клиента (сейчас сток).
---
<section class="hero">
  <img class="hero__bg" src="/img/hero-home-1600.webp" srcset="/img/hero-home-900.webp 900w, /img/hero-home-1600.webp 1600w, /img/hero-home-2400.webp 2400w" sizes="100vw" width="2400" height="1372" alt="Современный дом с панорамным остеклением" fetchpriority="high" decoding="async" />
  <div class="hero__shade"></div>

  <div class="container hero__inner">
    <div class="hero__text">
      <h1><span data-ed="home.hero.0">{hero[0]}</span> <span data-ed="home.hero.1">{hero[1]}</span></h1>
      <div class="hero__cta">
        <Button href="/#zayavka" size="lg">Оставить заявку</Button>
        <span class="hero__more"><Button href="#produkciya" variant="ghost-light" size="lg">Узнать больше</Button></span>
      </div>
      <ul class="hero__stats" aria-label="О компании" data-hero-stats>
        {heroStats.map((s, n) => { const [num, ...rest] = s.split(' '); return <li data-stat={n}><b>{num}</b><span>{rest.join(' ')}</span></li>; })}
      </ul>
    </div>
  </div>
</section>

<script>
  // Карточка со статистикой: числа «набегают» от нуля, когда карточка появляется на экране.
  // Если админка изменила значение (live-data.js), счёт для этой ячейки запускается заново.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const box = document.querySelector<HTMLElement>('[data-hero-stats]');

  const parse = (t: string) => {
    const m = t.trim().match(/^(\D*?)(\d[\d\s]*)(.*)$/);
    return m ? { pre: m[1], n: parseInt(m[2].replace(/\s/g, ''), 10), spaced: /\s/.test(m[2]), post: m[3] } : null;
  };
  const fmt = (v: number, spaced: boolean) => (spaced || v >= 10000 ? v.toLocaleString('ru-RU') : String(v));
  const ease = (x: number) => (x === 1 ? 1 : 1 - Math.pow(2, -10 * x)); // easeOutExpo

  const run = (b: HTMLElement, delay: number) => {
    const p = parse(b.dataset.val || b.textContent || '');
    if (!p || reduce) return;
    b.style.minWidth = '';
    b.style.minWidth = b.getBoundingClientRect().width + 'px'; // ширина финального числа: ячейка не «дышит» при счёте
    const dur = 1500 + Math.min(p.n, 2000) * 0.15;
    let t0 = 0;
    const tick = (now: number) => {
      if (!t0) t0 = now;
      const k = Math.min(1, (now - t0) / dur);
      b.textContent = p.pre + fmt(Math.round(p.n * ease(k)), p.spaced) + p.post;
      if (k < 1) requestAnimationFrame(tick);
      else { b.closest('li')?.classList.add('is-done'); b.dataset.running = ''; }
    };
    b.textContent = p.pre + '0' + p.post;
    b.closest('li')?.classList.remove('is-done');
    b.dataset.running = '1';
    setTimeout(() => requestAnimationFrame(tick), delay);
  };

  if (box) {
    const items = [...box.querySelectorAll<HTMLElement>('li b')];
    items.forEach((b) => { b.dataset.val = b.textContent || ''; });
    let started = false;
    const start = () => { if (started) return; started = true; items.forEach((b, i) => run(b, 750 + i * 170)); };
    if ('IntersectionObserver' in window && !reduce) {
      new IntersectionObserver((es, io) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); start(); } }, { threshold: 0.4 }).observe(box);
    }
    // значение пришло из админки
    document.addEventListener('hero:stat', (e) => {
      const b = items[(e as CustomEvent).detail];
      if (b && started) run(b, 0);
    });
  }

  // Мягкий параллакс: фон чуть отстаёт от прокрутки, пока виден первый экран
  const bg = document.querySelector<HTMLElement>('.hero__bg');
  if (bg && !reduce) {
    let ticking = false;
    const upd = () => { ticking = false; const y = Math.min(window.scrollY, 900); bg.style.setProperty('--py', y * 0.18 + 'px'); };
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(upd); } }, { passive: true });
  }
</script>

<style>
  .hero { position: relative; isolation: isolate; color: #fff; background: #0b1522; overflow: hidden;
    height: calc(100svh - var(--header-h)); min-height: 520px; display: flex; align-items: center; }
  .hero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; z-index: -3; }
  .hero__shade { position: absolute; inset: 0; z-index: -2;
    background:
      linear-gradient(0deg, rgb(8 16 26 / .85) 0%, rgb(8 16 26 / .55) 35%, rgb(8 16 26 / 0) 70%),
      linear-gradient(90deg, rgb(8 16 26 / .6) 0%, rgb(8 16 26 / .25) 45%, rgb(8 16 26 / 0) 75%),
      linear-gradient(180deg, rgb(8 16 26 / .35) 0%, rgb(8 16 26 / 0) 25%, rgb(8 16 26 / 0) 60%, rgb(8 16 26 / .7) 88%, #0b1522 100%); }
  /* блок текста стоит чуть выше геометрического центра */
  .hero__inner { width: 100%; padding-block: 0 calc(var(--mobilebar-h) + 5svh); }
  .hero h1 { color: #fff; font-weight: 700; letter-spacing: -.035em; line-height: 1.02; margin: 0 0 clamp(1.25rem, 2.5vw, 2.25rem);
    font-size: clamp(1.7rem, 6.3vw, 5rem); text-shadow: 0 2px 40px rgb(0 0 0 / .4); }
  .hero h1 span { display: block; white-space: nowrap; }
  .hero h1 span + span { color: rgb(255 255 255 / .82); font-weight: 500; }
  .hero__stats { list-style: none; margin: clamp(1.25rem, 3svh, 2rem) 0 0; padding: .4rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: .25rem; width: 100%; max-width: 26rem; border-radius: 20px; background: rgb(255 255 255 / .1); border: 1px solid rgb(255 255 255 / .22); backdrop-filter: blur(18px) saturate(150%); -webkit-backdrop-filter: blur(18px) saturate(150%); text-align: center; }
  .hero__stats li { padding: .6rem .3rem; border-radius: 14px; display: flex; flex-direction: column; align-items: center; gap: .2rem; }
  .hero__stats b { font: 700 1.2rem/1 var(--font-head); letter-spacing: -.02em; color: #fff; }
  .hero__stats span { font: 500 .6875rem/1.25 var(--font-body, inherit); color: rgb(255 255 255 / .75); }
  .hero__stats li:last-child b { color: var(--c-star, #f5b83d); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--sp-3); }
  .hero__stats b { font-variant-numeric: tabular-nums; display: inline-block; }
  .hero__stats { position: relative; overflow: hidden; }
  .hero__stats li { transition: background .35s var(--ease), transform .35s var(--ease); }
  .hero__stats li:hover { background: rgb(255 255 255 / .12); transform: translateY(-2px); }
  /* после счёта число слегка «вспыхивает» */
  .hero__stats li.is-done b { animation: statPop .7s var(--ease) both; }
  .hero__bg { transform: translate3d(0, var(--py, 0px), 0) scale(1.04); will-change: transform; }

  @media (prefers-reduced-motion: no-preference) {
    /* вход: фон медленно «отъезжает», заголовок поднимается строками, затем кнопки и карточка */
    .hero__bg { animation: heroZoom 2.8s cubic-bezier(.22, .8, .25, 1) both; }
    .hero h1 span { animation: heroRise 1.05s cubic-bezier(.22, .8, .25, 1) both; }
    .hero h1 span:nth-child(1) { animation-delay: .12s; }
    .hero h1 span:nth-child(2) { animation-delay: .3s; }
    .hero__cta { animation: heroRise .9s cubic-bezier(.22, .8, .25, 1) .55s both; }
    .hero__stats { animation: heroCard 1.1s cubic-bezier(.22, .8, .25, 1) .7s both; }
    .hero__stats li { animation: heroRise .8s cubic-bezier(.22, .8, .25, 1) both; }
    .hero__stats li:nth-child(1) { animation-delay: .95s; }
    .hero__stats li:nth-child(2) { animation-delay: 1.1s; }
    .hero__stats li:nth-child(3) { animation-delay: 1.25s; }
    /* блик, один раз пробегающий по стеклу, когда числа досчитали */
    .hero__stats::after { content: ''; position: absolute; inset: 0; pointer-events: none; border-radius: inherit;
      background: linear-gradient(105deg, transparent 35%, rgb(255 255 255 / .28) 50%, transparent 65%); transform: translateX(-120%);
      animation: heroSheen 1.6s cubic-bezier(.4, 0, .2, 1) 2.7s 1 both; }
  }
  @keyframes heroZoom { from { transform: translate3d(0, var(--py, 0px), 0) scale(1.14); } to { transform: translate3d(0, var(--py, 0px), 0) scale(1.04); } }
  @keyframes heroRise { from { opacity: 0; transform: translateY(26px); filter: blur(8px); } to { opacity: 1; transform: none; filter: none; } }
  @keyframes heroCard { from { opacity: 0; transform: translateY(34px) scale(.94); filter: blur(10px); } to { opacity: 1; transform: none; filter: none; } }
  @keyframes heroSheen { from { transform: translateX(-120%); } to { transform: translateX(120%); } }
  @keyframes statPop { 0% { transform: scale(1); } 40% { transform: scale(1.14); text-shadow: 0 0 22px rgb(255 255 255 / .55); } 100% { transform: scale(1); } }

  /* Телефон: текст внизу на тёмном градиенте (читаемо на любом фото), одна кнопка (дубль «Позвонить / Заявка» есть в нижней панели) */
  @media (max-width: 899.98px) {
    .hero { align-items: flex-end; }
    .hero__inner { padding-bottom: calc(var(--mobilebar-h) + 1.25rem); }
    .hero__shade { background:
      linear-gradient(0deg, #0b1522 0%, rgb(8 16 26 / .92) 30%, rgb(8 16 26 / .55) 58%, rgb(8 16 26 / 0) 85%),
      linear-gradient(180deg, rgb(8 16 26 / .3) 0%, rgb(8 16 26 / 0) 22%); }
    .hero__more { display: none; }
    .hero__cta :global(.btn) { width: 100%; max-width: 24rem; justify-content: center; min-height: 44px; padding: .55rem 1.25rem; font-size: var(--fs-sm); }
  }

  @media (min-width: 900px) {
    .hero__inner { padding-bottom: 0; margin-bottom: 0; }
    .hero h1 { font-size: clamp(2rem, 4.2vw, 3.75rem); }
    .hero__stats { position: absolute; right: max(var(--gutter), calc((100% - var(--container)) / 2)); bottom: clamp(2rem, 7svh, 4.5rem); margin: 0; padding: .5rem; width: fit-content; max-width: none; display: flex; gap: .35rem; }
    .hero__stats li { padding: .85rem 1.5rem; min-width: 8.5rem; }
    .hero__stats b { font-size: 1.75rem; }
    .hero__stats span { font-size: .8125rem; }
  }
</style>
