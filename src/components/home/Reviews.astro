---
import Icon from '../Icon.astro';
import { reviews as all } from '../../config/reviews.mjs'; // TODO: черновые отзывы, см. config/reviews.mjs
// В один ряд — три отзыва (первые отмеченные для главной; порядок и отметка — в public/data/reviews.json)
const reviews = all.filter((r) => r.home !== false).slice(0, 3);
const initials = (n = '') => n.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
---
<section class="section" aria-labelledby="rev-title">
  <div class="container">
    <div class="rev__head">
      <h2 id="rev-title">Отзывы клиентов</h2>
    </div>
    <ul class="rev" data-reviews aria-label="Отзывы клиентов">
      {reviews.map((r) => (
        <li class="rcard">
          <svg class="rcard__q" viewBox="0 0 48 40" width="56" height="46" aria-hidden="true"><path fill="currentColor" d="M0 40V22C0 9.5 6.5 2 19 0l2.2 6.2C14.5 8 11.5 12 11 18h10v22H0zm27 0V22C27 9.5 33.5 2 46 0l2 6.2C41.500 8 38.500 12 38 18h10v22H27z"/></svg>
          <div class="rcard__stars" role="img" aria-label="Оценка 5 из 5">
            {Array.from({ length: 5 }).map(() => <Icon name="star" size={18} />)}
          </div>
          <div class="rcard__body">
            <blockquote data-rev="text">{r.text}</blockquote>
            <button type="button" class="rcard__more" hidden data-rev-more>Читать полностью</button>
          </div>
          <div class="rcard__who">
            <span class="rcard__ava" data-rev="ava" aria-hidden="true">{initials(r.name)}</span>
            <span class="rcard__name"><strong data-rev="name">{r.name}</strong></span>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .rev__head { margin-bottom: var(--sp-5); }
  .rev__head h2 { margin: 0; }
  .rev { --gap: var(--sp-3); list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--gap); }
  .rcard { position: relative; isolation: isolate; display: flex; flex-direction: column; gap: var(--sp-4); padding: var(--sp-5); background: #fff; border: 1px solid var(--c-line); border-radius: 26px; overflow: hidden; transition: transform .45s var(--ease), border-color .3s var(--ease); }
  .rcard:hover { transform: translateY(-4px); border-color: #b9ccf8; }
  .rcard__q { position: absolute; z-index: -1; top: 1.1rem; right: 1.4rem; color: #e6edff; }
  .rcard__stars { display: flex; gap: 4px; color: var(--c-star); }
  .rcard__stars :global(svg) { fill: currentColor; stroke: none; }
  .rcard__body { flex: 1; display: flex; flex-direction: column; align-items: flex-start; gap: .75rem; min-width: 0; }
  .rcard blockquote { margin: 0; font-size: 1.0625rem; line-height: 1.55; letter-spacing: -.005em; color: var(--c-navy-900); font-weight: 500; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 7; line-clamp: 7; overflow: hidden; overflow-wrap: anywhere; }
  .rcard.is-open blockquote { -webkit-line-clamp: unset; line-clamp: unset; display: block; }
  .rcard__more { padding: 0; border: 0; background: none; color: var(--c-link, #2a5bd7); font: 700 var(--fs-sm)/1.3 var(--font-head); cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .rcard__who { display: flex; align-items: center; gap: .85rem; padding-top: var(--sp-4); border-top: 1px solid var(--c-line); }
  .rcard__ava { flex: none; width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; background: linear-gradient(135deg, #3672ff, #7aa1ff); color: #fff; font: 700 .9rem/1 var(--font-head); letter-spacing: .02em; }
  .rcard__name { display: grid; gap: .15rem; min-width: 0; }
  .rcard__name strong { font: 700 var(--fs-md)/1.2 var(--font-head); color: var(--c-navy-900); }

  @media (min-width: 900px) { .rev { grid-template-columns: repeat(3, minmax(0, 1fr)); --gap: var(--sp-4); } }
  @media (prefers-reduced-motion: reduce) { .rcard { transition: none; } .rcard:hover { transform: none; } }
</style>
