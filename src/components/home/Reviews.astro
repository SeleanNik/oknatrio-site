---
import Icon from '../Icon.astro';
import { reviews as all } from '../../config/reviews.mjs'; // TODO: черновые отзывы, см. config/reviews.mjs
const reviews = all.filter((r) => r.home !== false);
const initials = (n = '') => n.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
---
<section class="section" aria-labelledby="rev-title">
  <div class="container">
    <div class="rev__head">
      <h2 id="rev-title">Отзывы клиентов</h2>
      <div class="rev__nav">
        <button type="button" class="rev__btn" data-rev-prev aria-label="Назад"><Icon name="arrow" size={18} /></button>
        <button type="button" class="rev__btn" data-rev-next aria-label="Вперёд"><Icon name="arrow" size={18} /></button>
      </div>
    </div>
    <ul class="rev" data-reviews tabindex="0" aria-label="Отзывы клиентов">
      {reviews.map((r) => (
        <li class="rcard">
          <svg class="rcard__q" viewBox="0 0 48 40" width="44" height="36" aria-hidden="true"><path fill="currentColor" d="M0 40V22C0 9.5 6.5 2 19 0l2.2 6.2C14.5 8 11.5 12 11 18h10v22H0zm27 0V22C27 9.5 33.5 2 46 0l2 6.2C41.500 8 38.500 12 38 18h10v22H27z"/></svg>
          <div class="rcard__stars" role="img" aria-label="Оценка 5 из 5">
            {Array.from({ length: 5 }).map(() => <Icon name="star" size={16} />)}
          </div>
          <div class="rcard__body">
            <blockquote data-rev="text">{r.text}</blockquote>
            <button type="button" class="rcard__more" hidden data-rev-more>Читать полностью</button>
          </div>
          <div class="rcard__who">
            <span class="rcard__ava" data-rev="ava" aria-hidden="true">{initials(r.name)}</span>
            <span class="rcard__name"><strong data-rev="name">{r.name}</strong></span>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .rev__head { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-3); margin-bottom: var(--sp-4); }
  .rev__head h2 { margin: 0; }
  .rev__nav { display: flex; gap: .5rem; flex: none; }
  .rev__btn { width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--c-line); background: #fff; color: var(--c-navy-900); display: grid; place-items: center; cursor: pointer; transition: background .2s, color .2s, opacity .2s; }
  .rev__btn:hover:not(:disabled) { background: var(--c-navy-900); color: #fff; }
  [data-rev-prev] :global(svg) { transform: scaleX(-1); }
  .rev__btn:disabled { opacity: .35; cursor: default; }
  .rev { --gap: var(--sp-3); --per: 1; list-style: none; margin: 0; padding: 0 0 .25rem; display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - var(--gap) * (var(--per) - 1)) / var(--per)); gap: var(--gap); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
  .rev::-webkit-scrollbar { display: none; }
  .rev > .rcard { scroll-snap-align: start; }
  .rcard { position: relative; display: flex; flex-direction: column; gap: var(--sp-3); padding: var(--sp-4); background: #fff; border: 1px solid var(--c-line); border-radius: 22px; overflow: hidden; }
  .rcard__q { position: absolute; top: 1rem; right: 1.1rem; color: #dfe7ff; }
  .rcard__stars { display: flex; gap: 3px; color: var(--c-amber-500); }
  .rcard__stars :global(svg) { fill: currentColor; stroke: none; }
  .rcard__body { flex: 1; display: flex; flex-direction: column; align-items: flex-start; gap: .6rem; min-width: 0; }
  .rcard blockquote { margin: 0; font-size: var(--fs-md); line-height: 1.45; color: var(--c-navy-900); font-weight: 500; position: relative; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 8; line-clamp: 8; overflow: hidden; overflow-wrap: anywhere; }
  .rcard.is-open blockquote { -webkit-line-clamp: unset; line-clamp: unset; display: block; }
  .rcard__more { padding: 0; border: 0; background: none; color: var(--c-link, #2a5bd7); font: 600 var(--fs-sm)/1.3 var(--font-head); cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .rcard__who { display: flex; align-items: center; gap: .75rem; padding-top: var(--sp-3); border-top: 1px solid var(--c-line); }
  .rcard__ava { flex: none; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: #e6edff; color: #2a5bd7; font: 700 .875rem/1 var(--font-head); letter-spacing: .02em; }
  .rcard__name { display: grid; gap: .15rem; min-width: 0; }
  .rcard__name strong { font: 700 var(--fs-sm)/1.2 var(--font-head); color: var(--c-navy-900); }
  @media (min-width: 640px) { .rev { --per: 2; } }
  @media (min-width: 960px) { .rev { --per: 3; --gap: var(--sp-4); } }
</style>
