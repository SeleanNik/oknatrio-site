---
// «Наши работы»: заголовок, три больших карточки с подписью и кнопка «Все работы».
import { pagesData } from '../../config/pages.mjs';
import Icon from '../Icon.astro';
import { works } from '../../config/works.mjs'; // TODO: реальные объекты
const items = works.slice(0, 3);
const hw = pagesData.home.works;
---
<section class="works" id="raboty" aria-labelledby="works-title">
  <div class="container">
    <div class="head">
      <h2 id="works-title" data-ed="home.works.title">{hw.title}</h2>
      <p data-ed="home.works.text">{hw.text}</p>
    </div>
    <div class="grid">
      {items.map((w, i) => (
        <figure class="w" data-ed-work={i} data-gallery={JSON.stringify(w.images)}>
          <img src={w.image} alt={w.title} width="800" height="1000" loading="lazy" decoding="async" />
          <figcaption><strong>{w.title}</strong><span>{w.place}</span></figcaption>
        </figure>
      ))}
    </div>
    <div class="more">
      <a class="more__btn" href="/nashi-raboty/">Все работы <Icon name="arrow" size={18} /></a>
    </div>
  </div>
</section>

<style>
  .works { padding-block: var(--section-y); background: var(--c-bg); }
  .head { margin-bottom: var(--sp-5); }
  .head h2 { margin-bottom: .35em; font-weight: 500; letter-spacing: -.02em; font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.5rem); }
  .head p { margin: 0; color: var(--c-text-muted); font-size: var(--fs-sm); max-width: 52ch; }
  .grid { display: grid; gap: var(--sp-3); grid-template-columns: 1fr; }
  .w { position: relative; margin: 0; border-radius: 22px; overflow: hidden; background: var(--c-navy-800); aspect-ratio: 4 / 3; }
  .w[hidden] { display: none; }
  .w :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease); }
  .w:hover :global(img) { transform: scale(1.04); }
  .w figcaption { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; display: grid; gap: .2rem; padding: 4rem 1.25rem 1.6rem; background: linear-gradient(180deg, transparent, rgb(8 16 26 / .72)); color: #fff; pointer-events: none; }
  .w figcaption strong { font: 600 var(--fs-md, 1.0625rem)/1.25 var(--font-head); }
  .w figcaption span { font-size: var(--fs-sm); color: rgb(255 255 255 / .8); }
  .more { display: flex; justify-content: center; margin-top: var(--sp-5); }
  .more__btn { display: inline-flex; align-items: center; gap: .5rem; min-height: 48px; padding: .7rem 1.6rem; border-radius: var(--r-pill); background: #0b0f14; color: #fff; text-decoration: none; font: 700 var(--fs-sm)/1 var(--font-head); transition: background .2s, gap .2s var(--ease); }
  .more__btn:hover { background: var(--c-amber-500); color: #fff; gap: .8rem; }

  @media (min-width: 800px) {
    .grid { grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); }
    .w { aspect-ratio: 4 / 5; }
  }
</style>
