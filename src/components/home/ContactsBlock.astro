---
import Icon from '../Icon.astro';
import Button from '../Button.astro';
import { site } from '../../config/site.config.mjs';

const { lat, lng } = site.geo;
const mapSrc = `https://yandex.ru/map-widget/v1/?ll=${lng}%2C${lat}&z=16&pt=${lng}%2C${lat}%2Cpm2rdm`;
---
<section class="section" aria-labelledby="contacts-title">
  <div class="container contacts">
    <div class="contacts__info">
      <h2 id="contacts-title">Контакты</h2>
      <ul>
        <li><Icon name="pin" /><span><strong>Адрес</strong>{site.address.full}</span></li>
        <li><Icon name="phone" /><span><strong>Телефон</strong><a href={`tel:${site.phone.href}`}>{site.phone.display}</a></span></li>
        <li><Icon name="clock" /><span><strong>Режим работы</strong>{site.hours}</span></li>
      </ul>
      <div class="contacts__cta">
        <Button modal="callback">Заказать звонок</Button>
        <Button href="/kontakty/" variant="outline">Все контакты</Button>
      </div>
    </div>
    <div class="contacts__map">
      <iframe src={mapSrc} title={`Карта: ${site.address.city}, ${site.address.street}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
    </div>
  </div>
</section>

<style>
  .contacts { display: grid; gap: var(--sp-6); }
  .contacts__info ul { list-style: none; margin: 0 0 var(--sp-5); padding: 0; display: grid; gap: var(--sp-4); }
  .contacts__info li { display: flex; gap: var(--sp-4); align-items: flex-start; }
  .contacts__info li :global(svg) { flex: none; color: var(--c-blue-600); margin-top: .2rem; }
  .contacts__info li span { display: grid; gap: .15rem; }
  .contacts__info strong { font: 700 var(--fs-xs)/1 var(--font-head); letter-spacing: .08em; text-transform: uppercase; color: var(--c-text-muted); }
  .contacts__info a { font-weight: 700; color: var(--c-navy-800); }
  .contacts__cta { display: flex; flex-wrap: wrap; gap: var(--sp-3); }
  .contacts__map { border-radius: var(--r-lg); overflow: hidden; min-height: 280px; background: var(--c-blue-100); }
  .contacts__map iframe { width: 100%; height: 100%; min-height: 280px; border: 0; display: block; }
  @media (min-width: 900px) { .contacts { grid-template-columns: 1fr 1.3fr; gap: var(--sp-8); align-items: stretch; } .contacts__map, .contacts__map iframe { min-height: 320px; } }
</style>
