---
// «Продукция»: 5 вертикальных фото-карточек (референс клиента): заголовок сверху, кнопка снизу.
// Фон секции продолжает затемнённый низ hero и переходит в цвет блока «Услуги».
import Icon from '../Icon.astro';
import { pagesData } from '../../config/pages.mjs';

const prod = pagesData.home.prod;
const tiles = prod.cards;
---
<section class="prod" id="produkciya" aria-labelledby="prod-title">
  <div class="container">
    <div class="prod__head">
      <h2 id="prod-title" data-ed="home.prod.title">{prod.title}</h2>
      <p data-ed="home.prod.text">{prod.text}</p>
    </div>
    <ul class="cards">
      {tiles.map((t) => (
        <li>
          <a class="tile" href={t.href}>
            <img class="tile__img" src={t.image} alt={t.brand ? `${t.title} ${t.brand}` : t.title} width="600" height="800" loading="lazy" decoding="async" />
            <span class="tile__top">
              <small hidden={!t.brand}>{t.brand ? t.title : ''}</small>
              <strong class={t.brand ? 'is-brand' : ''}>{t.brand || t.title}</strong>
            </span>
            <span class="tile__btn">Подробнее <Icon name="arrow" size={16} /></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .prod { padding-block: var(--sp-6) var(--sp-8); color: #fff; background: linear-gradient(180deg, #0b1522 0%, #12161c 100%); }
  .prod__head { display: grid; gap: var(--sp-3); margin-bottom: var(--sp-5); align-items: end; }
  .prod h2 { color: #fff; margin: 0; font-weight: 500; letter-spacing: -.02em; font-size: clamp(2rem, 1.4rem + 2.6vw, 3.5rem); line-height: 1; }
  .prod__head p { margin: 0; color: rgb(255 255 255 / .6); font-size: var(--fs-sm); max-width: 38ch; }

  /* мобильные: горизонтальная лента со «снэпом»; от 900px: сетка */
  .cards { list-style: none; margin: 0 calc(var(--gutter) * -1); padding: 0 var(--gutter) .5rem; display: flex; gap: var(--sp-3); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .cards::-webkit-scrollbar { display: none; }
  .cards li { flex: 0 0 78%; max-width: 320px; scroll-snap-align: start; }

  .tile { position: relative; display: flex; flex-direction: column; justify-content: space-between; aspect-ratio: 4 / 5.1; padding: 1.15rem; border-radius: 24px; overflow: hidden; isolation: isolate; color: #fff; text-decoration: none; }
  .tile__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform .9s var(--ease); }
  .tile:hover .tile__img { transform: scale(1.06); }
  .tile::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgb(8 16 26 / .72) 0%, rgb(8 16 26 / .2) 34%, rgb(8 16 26 / 0) 55%, rgb(8 16 26 / .55) 100%); }
  .tile__top { display: grid; gap: .4rem; justify-items: start; }
  .tile__top strong { font: 700 clamp(1.05rem, .9rem + .5vw, 1.3rem)/1.1 var(--font-head); text-transform: uppercase; letter-spacing: .01em; }
  .tile__top small { font: 600 .6875rem/1.2 var(--font-head); letter-spacing: .16em; text-transform: uppercase; color: rgb(255 255 255 / .8); }
  .tile__top strong.is-brand { font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem); font-weight: 800; letter-spacing: .02em; line-height: 1; }
  .tile__btn { align-self: stretch; display: inline-flex; align-items: center; justify-content: center; gap: .45rem; min-height: 44px; padding: .5rem 1rem; border-radius: var(--r-pill); background: rgb(255 255 255 / .14); border: 1px solid rgb(255 255 255 / .4); backdrop-filter: blur(12px) saturate(140%); -webkit-backdrop-filter: blur(12px) saturate(140%); color: #fff; font: 700 .75rem/1 var(--font-head); text-transform: uppercase; letter-spacing: .05em; transition: background .2s, border-color .2s, gap .2s var(--ease); }
  .tile:hover .tile__btn { background: var(--c-amber-500); border-color: var(--c-amber-500); gap: .75rem; }

  @media (min-width: 900px) {
    .prod__head { grid-template-columns: 1fr 1fr; }
    .prod__head p { justify-self: end; text-align: right; }
    .cards { display: grid; grid-template-columns: repeat(6, 1fr); grid-template-rows: 400px 270px; overflow: visible; margin: 0; padding: 0; gap: var(--sp-3); }
    .cards li { grid-column: span 2; max-width: none; }
    .cards li:nth-child(n + 4) { grid-column: span 3; }
    .tile { aspect-ratio: auto; height: 100%; padding: 1.4rem; }
    .tile__top strong { font-size: clamp(1.15rem, .9rem + .7vw, 1.6rem); }
    .tile__btn { align-self: flex-start; min-width: 190px; }
  }
  @media (min-width: 1000px) { .prod { padding-block: var(--sp-7) var(--sp-9); } .cards { gap: var(--sp-4); grid-template-rows: 420px 280px; } }
</style>
