---
// Адаптивная картинка (WebP, srcset, lazy). photo — ключ из src/config/img.mjs
import { photos, unsplash, srcset } from '../config/img.mjs';
const { photo, alt = '', ratio = 0.75, widths = [480, 800, 1200], sizes = '100vw', eager = false, class: cls = '' } = Astro.props;
const id = photos[photo] ?? photo;
const w = widths[widths.length - 1];
---
<img
  class={cls}
  src={unsplash(id, 800, Math.round(800 * ratio))}
  srcset={srcset(id, widths, ratio)}
  sizes={sizes}
  width={w}
  height={Math.round(w * ratio)}
  alt={alt}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
/>
