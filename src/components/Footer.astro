---
import Logo from './Logo.astro';
import { footerExtra, legalDocs } from '../config/nav.mjs';
import { razdely, typeLinks } from '../config/razdely.mjs';
import { brandsOf } from '../config/brands.mjs';
import { site } from '../config/site.config.mjs';

// У разделов с noPage (алюминий) своей страницы нет: заголовок без ссылки, внутри ссылки на страницы брендов.
const cols = Object.values(razdely).map((r) => r.noPage
  ? { title: r.title, href: '', links: brandsOf(r.key).map((b) => [`Окна ${b.name}`, b.path]) }
  : { title: r.title, href: r.path, links: typeLinks(r) });
---
<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <Logo light />
      <a href={`tel:${site.phone.href}`} class="footer__phone" data-bind-href="phone.href" data-bind-prefix="tel:" data-bind="phone.display">{site.phone.display}</a>
      <dl class="footer__contacts">
        <div><dt>Адрес</dt><dd data-bind="address.full">{site.address.full}</dd></div>
        <div><dt>Почта</dt><dd><a href={`mailto:${site.email}`} data-bind-href="email" data-bind-prefix="mailto:" data-bind="email">{site.email}</a></dd></div>
        <div><dt>Режим работы</dt><dd data-bind="hours">{site.hours}</dd></div>
      </dl>
    </div>
    {cols.map((c) => (
      <nav class="footer__col" aria-label={c.title}>
        <p class="footer__title">{c.href ? <a href={c.href}>{c.title}</a> : c.title}</p>
        <ul>{c.links.map(([t, h]) => <li><a href={h}>{t}</a></li>)}</ul>
      </nav>
    ))}
    <nav class="footer__col" aria-label="Ещё">
      <p class="footer__title">Ещё</p>
      <ul>{footerExtra.map(([t, h]) => <li><a href={h}>{t}</a></li>)}</ul>
    </nav>
  </div>
  <nav class="container footer__legal" aria-label="Документы">
    {legalDocs.map(([t, h]) => <a href={h}>{t}</a>)}
  </nav>
  <div class="container footer__bottom">
    <span>© 1996–{new Date().getFullYear()}{site.name}{site.legalName && `. ${site.legalName}`}</span>
    {site.requisites && <span>{site.requisites}</span>}
  </div>
</footer>

<style>
  .footer { background: var(--c-navy-900); color: var(--c-on-dark-muted); padding-top: var(--sp-7); font-size: var(--fs-sm); }
  .footer a { color: var(--c-on-dark-muted); text-decoration: none; transition: color .2s; }
  .footer a:hover { color: #fff; }
  .footer__grid { display: grid; gap: var(--sp-6) var(--sp-5); grid-template-columns: 1fr 1fr; padding-bottom: var(--sp-6); }
  .footer__brand { grid-column: 1 / -1; }
  .footer__brand { display: grid; gap: var(--sp-4); justify-items: start; align-content: start; }
  .footer__phone { font: 800 1.5rem/1 var(--font-head); color: #fff !important; letter-spacing: -.01em; }
  .footer__title { font: 700 var(--fs-xs)/1 var(--font-head); letter-spacing: .1em; text-transform: uppercase; color: #fff; margin: 0 0 var(--sp-3); }
  .footer__title a { color: #fff; }
  .footer__col ul { list-style: none; padding: 0; margin: 0; display: grid; gap: .1rem; }
  .footer__col li a { display: inline-block; padding: .28rem 0; }
  .footer__contacts { margin: var(--sp-2) 0 0; display: grid; gap: var(--sp-3); }
  .footer__contacts dt { font: 600 .6875rem/1 var(--font-head); letter-spacing: .08em; text-transform: uppercase; color: rgb(255 255 255 / .45); margin-bottom: .3rem; }
  .footer__contacts dd { margin: 0; color: #fff; }
  .footer__contacts dd a { color: #fff; }
  .footer__legal { display: flex; flex-wrap: wrap; gap: .2rem var(--sp-5); padding-block: var(--sp-4) var(--sp-3); border-top: 1px solid rgb(255 255 255 / .12); font-size: var(--fs-xs); }
  .footer__legal + .footer__bottom { border-top: 0; padding-top: 0; }
  .footer__legal a { padding: .25rem 0; color: rgb(255 255 255 / .7); }
  .footer__bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--sp-2) var(--sp-5); padding-block: var(--sp-4); border-top: 1px solid rgb(255 255 255 / .12); font-size: var(--fs-xs); color: rgb(255 255 255 / .5); }
  @media (min-width: 700px) { .footer__grid { grid-template-columns: repeat(3, 1fr); } .footer__brand { grid-column: 1 / -1; } .footer__contacts { grid-template-columns: repeat(3, auto); justify-content: start; gap: var(--sp-6); } }
  @media (min-width: 960px) {
    .footer__grid { grid-template-columns: 1.3fr 1.1fr 1.1fr .9fr; } .footer__brand { grid-column: auto; } .footer__contacts { grid-template-columns: 1fr; gap: var(--sp-3); }
  }
</style>
