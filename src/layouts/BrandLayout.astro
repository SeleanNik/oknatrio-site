---
// Страница производителя профиля: hero → якоря по типам (в «окнах» переключатель систем) → наши работы → каталог → FAQ → заявка → SEO-текст.
// Данные: src/config/brands.mjs. Все панели лежат в HTML, скрытие делает скрипт внизу.
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Button from '../components/Button.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import Img from '../components/Img.astro';
import LeadBlock from '../components/home/LeadBlock.astro';
import { site, siteUrl } from '../config/site.config.mjs';
import { works } from '../config/works.mjs';
import { razdely } from '../config/razdely.mjs';
import { typesOf } from '../config/brands.mjs';

const { b } = Astro.props;
const parent = razdely[b.parent];
const types = typesOf(b);
const objects = works.filter((w) => `${w.title} ${w.place}`.toLowerCase().includes(b.worksMatch.toLowerCase())).slice(0, 4);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: b.h1,
  description: b.description,
  areaServed: 'Москва и Московская область',
  provider: { '@type': 'HomeAndConstructionBusiness', name: site.name, url: siteUrl },
};
---
<Base title={b.seoTitle} description={b.description} jsonLd={[ld]}>
  <section class="bh">
    <div class="bh__media">
      {b.heroImage
        ? <img src={b.heroImage} alt={b.photoAlt} width="828" height="1017" fetchpriority="high" decoding="async" />
        : <Img photo={b.photo} alt={b.photoAlt} ratio={0.62} widths={[800, 1400, 2000]} sizes="70vw" eager />}
    </div>
    <div class="bh__crumbs"><Breadcrumbs items={[{ title: 'Окна', href: '' }, ...(parent.noPage ? [] : [{ title: parent.title, href: parent.path }]), { title: b.name }]} /></div>
    <div class="container bh__in">
      <div class="bh__text">
        <h1>{b.h1}</h1>
        <p class="bh__lead">{b.lead}</p>
        <div class="bh__cta">
          <Button href="/#zayavka" size="lg">Оставить заявку</Button>
          <Button href="#sistemy" variant="outline" size="lg">Системы {b.name}</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="sys" id="sistemy" aria-labelledby="sys-title">
    <div class="container">
      <h2 id="sys-title">Что мы делаем из профиля {b.name}</h2>
    </div>
    <nav class="anchors" aria-label="Типы конструкций" data-anchors>
      <div class="container anchors__wrap">
        <button class="anchors__arr anchors__arr--l" type="button" aria-label="Прокрутить влево" data-arr="-1" hidden>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg>
        </button>
        <div class="anchors__in" data-anchors-scroll>
          {types.map((t) => <a class="anchors__a" href={`#${t.id}`} data-anchor={t.id}>{t.title}</a>)}
        </div>
        <button class="anchors__arr anchors__arr--r" type="button" aria-label="Прокрутить вправо" data-arr="1" hidden>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
        </button>
      </div>
    </nav>

    <div class="container sys__list">
      {types.map((t) => (
        <section class="type" id={t.id} aria-labelledby={`h-${t.id}`}>
          <h3 class="type__h" id={`h-${t.id}`}>{t.title}</h3>
          {t.systems ? (
            <div data-systems>
              <p class="sys__hint">Профильные системы {b.name}: выберите, чтобы увидеть параметры.</p>
              <div class="sys__tabs" role="tablist" aria-label={`Системы ${b.name}`}>
                {t.systems.map((s, i) => (
                  <button class="stab" role="tab" type="button" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} data-sys={s.id}>
                    <span class="stab__thumb">
                      {s.image ? <img src={s.image} alt="" loading="lazy" decoding="async" width="120" height="120" /> : <b>{s.name}</b>}
                    </span>
                    <span class="stab__name">{s.name}</span>
                    <span class="stab__tag">{s.tag}</span>
                  </button>
                ))}
              </div>
              {t.systems.map((s) => (
                <article class="spanel" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} data-spanel={s.id}>
                  <div class="spanel__media">
                    {s.image
                      ? <img src={s.image} alt={`Профиль ${b.name} ${s.name} в разрезе`} loading="lazy" decoding="async" width="500" height="500" />
                      : <span class="spanel__ph"><small>{b.name}</small><b>{s.name}</b></span>}
                  </div>
                  <div class="spanel__body">
                    <span class="spanel__tag">{s.tag}</span>
                    <h4>{b.name} {s.name}</h4>
                    <p>{s.text}</p>
                    <ul class="spanel__specs">{s.specs.map((x) => <li><Icon name="check" size={16} />{x}</li>)}</ul>
                    <div class="spanel__cta">
                      <Button href="/#zayavka" size="lg">Оставить заявку</Button>
                      <a class="spanel__cat" href={b.techHref}><Icon name="file" size={18} />Каталог системы</a>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <article class="spanel">
              <div class="spanel__media"><img src={t.src} alt={t.alt || t.title} loading="lazy" decoding="async" width="800" height="600" class="spanel__photo" /></div>
              <div class="spanel__body">
                <p>{t.text}</p>
                <ul class="spanel__specs">{t.points.map((x) => <li><Icon name="check" size={16} />{x}</li>)}</ul>
                <div class="spanel__cta">
                  <Button href="/#zayavka" size="lg">Оставить заявку</Button>
                  <a class="spanel__cat" href={b.techHref}><Icon name="file" size={18} />Технический каталог</a>
                </div>
              </div>
            </article>
          )}
        </section>
      ))}
    </div>
  </section>

  {objects.length > 0 && (
    <section class="objects" aria-labelledby="obj-title">
      <div class="container">
        <div class="head"><h2 id="obj-title">Наши работы</h2><Button href={`/nashi-raboty/#${b.tag}`} variant="outline" size="sm">Все работы</Button></div>
        <ul class="ogrid">
          {objects.map((w) => (
            <li><figure data-gallery={JSON.stringify(w.images)}>
              <img src={w.image} alt={w.title} loading="lazy" decoding="async" width="480" height="320" />
            </figure></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <Faq items={b.faq} />

  <section class="seo container">
    {b.seo.map((t) => <p>{t}</p>)}
  </section>

  <LeadBlock product={`${parent.title} ${b.name}`} />
</Base>

<script>
  // Один уровень: якоря-разделы по типам; в «окнах» переключатель систем. #тип или #система прокручивают к нужному месту.
  const syss = [...document.querySelectorAll('[data-sys]')];
  const spanels = [...document.querySelectorAll('[data-spanel]')];
  const showSys = (id) => {
    syss.forEach((t) => { const on = t.dataset.sys === id; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; });
    spanels.forEach((p) => { p.hidden = p.dataset.spanel !== id; });
  };
  if (syss[0]) {
    showSys(syss[0].dataset.sys);
    syss.forEach((t, i) => {
      t.addEventListener('click', () => showSys(t.dataset.sys));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        const n = syss[(i + d + syss.length) % syss.length];
        n.focus();
        showSys(n.dataset.sys);
      });
    });
    const fromHash = () => {
      const id = location.hash.slice(1);
      const t = syss.find((x) => x.dataset.sys === id);
      if (t) { showSys(id); t.closest('.type').scrollIntoView(); }
    };
    fromHash();
    window.addEventListener('hashchange', fromHash);
  }

  // Подсветка текущего раздела в липкой навигации. Прокручиваем только саму смужку (scrollLeft), страницу не трогаем.
  const links = [...document.querySelectorAll('[data-anchor]')];
  const bar = document.querySelector('[data-anchors-scroll]');
  const secs = links.map((l) => document.getElementById(l.dataset.anchor)).filter(Boolean);
  if (bar) {
    const arrL = document.querySelector('[data-arr="-1"]');
    const arrR = document.querySelector('[data-arr="1"]');
    const upd = () => {
      arrL.hidden = bar.scrollLeft < 8;
      arrR.hidden = bar.scrollLeft + bar.clientWidth > bar.scrollWidth - 8;
    };
    [arrL, arrR].forEach((a) => a.addEventListener('click', () => bar.scrollBy({ left: Number(a.dataset.arr) * bar.clientWidth * 0.6, behavior: 'smooth' })));
    bar.addEventListener('scroll', upd, { passive: true });
    window.addEventListener('resize', upd);
    upd();
  }
  if (links.length && bar && 'IntersectionObserver' in window) {
    let lock = 0;
    let cur = '';
    const mark = (id) => {
      if (id === cur) return;
      cur = id;
      links.forEach((l) => {
        const on = l.dataset.anchor === id;
        l.classList.toggle('is-on', on);
        if (on) bar.scrollTo({ left: l.offsetLeft - (bar.clientWidth - l.offsetWidth) / 2, behavior: 'auto' });
      });
    };
    // При клике подсвечиваем цель сразу и не реагируем на разделы, которые пролетаем по пути.
    links.forEach((l) => l.addEventListener('click', () => { mark(l.dataset.anchor); lock = Date.now() + 1000; }));
    const io = new IntersectionObserver((es) => {
      if (Date.now() < lock) return;
      const v = es.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      if (v) mark(v.target.id);
    }, { rootMargin: '-120px 0px -55% 0px' });
    secs.forEach((s) => io.observe(s));
  }
</script>

<style>
  /* hero: светлый фон, фото справа плавно «перетекает» в заголовок (как в разделах) */
  .bh { position: relative; isolation: isolate; overflow: hidden; display: flex; align-items: center; min-height: clamp(460px, 62svh, 640px); background: var(--c-bg); }
  .bh__media { position: absolute; inset: 0 0 0 auto; width: 100%; z-index: -1; }
  .bh__media img, .bh__media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; display: block; }
  .bh__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(246 247 248 / .92) 0%, rgb(246 247 248 / .88) 55%, rgb(246 247 248 / .55) 100%); }
  .bh__media::before { content: ''; position: absolute; inset: auto 0 0 0; height: 38%; z-index: 1; background: linear-gradient(0deg, var(--c-bg) 0%, rgb(246 247 248 / 0) 100%); pointer-events: none; }
  .bh__crumbs { position: absolute; top: 0; left: 0; right: 0; z-index: 2; }
  .bh__in { width: 100%; padding-block: var(--sp-8) var(--sp-7); }
  .bh__text { max-width: 40rem; }
  .bh h1 { margin: 0 0 .35em; font-size: clamp(1.75rem, 1.1rem + 3vw, 3.4rem); font-weight: 700; letter-spacing: -.03em; line-height: 1.05; }
  .bh__lead { color: var(--c-text-muted); margin: 0 0 var(--sp-5); font-size: var(--fs-lg); max-width: 38ch; }
  .bh__cta { display: flex; flex-wrap: wrap; gap: var(--sp-3); }
  @media (min-width: 800px) {
    .bh__media { width: 68%; }
    .bh__media::after { background: linear-gradient(90deg, var(--c-bg) 0%, rgb(246 247 248 / .55) 35%, rgb(246 247 248 / 0) 75%); }
  }

  .sys { padding-top: var(--section-y); scroll-margin-top: var(--header-h); }
  .sys h2 { margin: 0 0 var(--sp-5); }
  .sys__hint { margin: 0 0 var(--sp-3); color: var(--c-muted, #5b6b7d); }
  .sys__list { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--sp-8); padding-block: var(--sp-7) var(--section-y); }

  /* панель типов: светлая, прилипает под шапкой; чипы-таблетки, активный — тёмный */
  .anchors { position: sticky; top: var(--header-h); z-index: 20; background: rgb(246 247 248 / .88); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom: 1px solid var(--c-line); }
  .anchors__wrap { position: relative; }
  .anchors__in { display: flex; gap: .5rem; overflow-x: auto; padding-block: .7rem; scrollbar-width: none; }
  .anchors__in::-webkit-scrollbar { display: none; }
  .anchors__a { flex: 0 0 auto; padding: .6rem 1.05rem; border: 1px solid var(--c-line); border-radius: 999px; background: #fff; font: 600 .9rem/1 var(--font-head); color: var(--c-navy-800); text-decoration: none; white-space: nowrap; transition: background .25s var(--ease), color .25s var(--ease), border-color .25s var(--ease); }
  .anchors__a:hover { border-color: #b9ccf8; color: var(--c-blue-600); }
  .anchors__a.is-on { background: var(--c-navy-900); border-color: var(--c-navy-900); color: #fff; }
  .anchors__a:focus-visible { outline: 2px solid var(--c-blue-500); outline-offset: 2px; }
  .anchors__arr { position: absolute; top: 0; bottom: 0; z-index: 1; width: 4rem; display: flex; align-items: center; border: 0; padding: 0 .2rem; color: var(--c-navy-800); cursor: pointer; }
  .anchors__arr[hidden] { display: none; }
  .anchors__arr svg { width: 2.1rem; height: 2.1rem; padding: .5rem; border-radius: 50%; background: #fff; border: 1px solid var(--c-line); transition: border-color .2s var(--ease), color .2s var(--ease); }
  .anchors__arr:hover svg { border-color: #b9ccf8; color: var(--c-blue-600); }
  .anchors__arr:focus-visible { outline: 2px solid var(--c-blue-500); outline-offset: -2px; }
  .anchors__arr--l { left: 0; justify-content: flex-start; background: linear-gradient(90deg, #f6f7f8 55%, transparent); }
  .anchors__arr--r { right: 0; justify-content: flex-end; background: linear-gradient(270deg, #f6f7f8 55%, transparent); }

  .type, .type > div { min-width: 0; }
  .type { scroll-margin-top: 3.5rem; }
  .type__h { margin: 0 0 var(--sp-4); font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2rem); letter-spacing: -.02em; }
  .spanel__media img.spanel__photo { object-fit: cover; padding: 0; background: none; }

  .sys__tabs { display: flex; gap: .6rem; overflow-x: auto; scroll-snap-type: x proximity; padding: .25rem .1rem .6rem; margin-bottom: var(--sp-3); scrollbar-width: thin; }
  .stab { flex: 0 0 auto; scroll-snap-align: start; width: 8.25rem; display: grid; gap: .15rem; justify-items: start; padding: .5rem .5rem .65rem; text-align: left; font: inherit; color: var(--c-navy-900); background: #fff; border: 1.5px solid var(--c-line); border-radius: 16px; cursor: pointer; transition: border-color .2s var(--ease), background .2s var(--ease); }
  .stab:hover { border-color: #b9ccf8; }
  .stab[aria-selected='true'] { border-color: var(--c-amber-500); background: #eef3ff; }
  .stab:focus-visible { outline: 2px solid var(--c-amber-500); outline-offset: 2px; }
  .stab__thumb { width: 100%; aspect-ratio: 16 / 11; border-radius: 10px; overflow: hidden; display: grid; place-items: center; background: linear-gradient(160deg, #1d2a44, #0b1522); margin-bottom: .35rem; }
  .stab__thumb img { width: 100%; height: 100%; object-fit: contain; padding: .4rem; background: #dfe5ee; }
  .stab__thumb b { color: rgb(255 255 255 / .9); font: 700 .8rem/1.1 var(--font-head); text-align: center; padding: 0 .3rem; }
  .stab__name { font: 700 .9rem/1.2 var(--font-head); }
  .stab__tag { font-size: .72rem; color: var(--c-muted, #5b6b7d); }

  .spanel { display: grid; gap: var(--sp-4); padding: var(--sp-4); background: #fff; border: 1px solid var(--c-line); border-radius: 24px; }
  .spanel[hidden] { display: none; }
  .spanel__media { border-radius: 18px; overflow: hidden; aspect-ratio: 4 / 3; display: grid; place-items: center; background: linear-gradient(160deg, #1d2a44, #0b1522); }
  .spanel__media img { width: 100%; height: 100%; object-fit: contain; padding: .4rem; background: #dfe5ee; }
  .spanel__ph { display: grid; gap: .25rem; text-align: center; color: #fff; }
  .spanel__ph small { color: rgb(255 255 255 / .6); font: 600 .8rem var(--font-head); letter-spacing: .12em; text-transform: uppercase; }
  .spanel__ph b { font: 800 clamp(1.8rem, 1.2rem + 3vw, 3rem)/1 var(--font-head); letter-spacing: -.03em; }
  .spanel__body { display: grid; gap: var(--sp-3); align-content: start; }
  .spanel__tag { justify-self: start; padding: .25rem .7rem; border-radius: 999px; background: #eef3ff; color: #2a5bd7; font: 600 .78rem var(--font-head); }
  .spanel h4, .spanel h3 { margin: 0; font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2rem); letter-spacing: -.02em; }
  .spanel p { margin: 0; color: var(--c-muted, #5b6b7d); max-width: 52ch; }
  .spanel__specs { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; }
  .spanel__specs li { display: flex; align-items: center; gap: .55rem; padding: .6rem .85rem; background: var(--c-bg); border-radius: 12px; font-weight: 600; font-size: .9rem; }
  .spanel__specs :global(svg) { color: var(--c-amber-500); flex: none; }
  .spanel__cta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-3) var(--sp-4); }
  .spanel__cat { display: inline-flex; align-items: center; gap: .45rem; font-weight: 600; color: #2a5bd7; text-decoration: none; }
  .spanel__cat:hover { text-decoration: underline; }

  .objects { padding-block: var(--section-y); }
  .head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--sp-3); margin-bottom: var(--sp-4); }
  .head h2 { margin: 0; }
  .ogrid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-3); grid-template-columns: 1fr 1fr; }
  .ogrid figure { margin: 0; position: relative; border-radius: var(--r-md); overflow: hidden; aspect-ratio: 4 / 5; background: var(--c-navy-800); }
  .ogrid img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s var(--ease); }
  .ogrid figure:hover img { transform: scale(1.05); }
  .seo { padding-block: var(--sp-6); display: grid; gap: var(--sp-3); max-width: 56rem; }
  .seo p { margin: 0; color: var(--c-muted, #5b6b7d); }

  @media (min-width: 800px) {
    .spanel { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: var(--sp-6); padding: var(--sp-5); align-items: center; }
    .spanel__media { aspect-ratio: 1 / 1; }
    .stab { width: 9.5rem; }
    .ogrid { grid-template-columns: repeat(4, 1fr); }
  }
</style>
