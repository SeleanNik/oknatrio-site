# Apache: HTTPS, 404-страница, редиректы. Домен в коде сайта не используется,
# поэтому правила с доменом ниже закомментированы — раскомментировать при деплое.
ErrorDocument 404 /404.html
DirectoryIndex index.html

RewriteEngine On

# ВРЕМЕННО: SSL-сертификата на хостинге пока нет, поэтому принудительный HTTPS ОТКЛЮЧЁН.
# Когда сертификат будет установлен и https://oknatrio.ru откроется без ошибки, раскомментировать (убрать «# ») три блока ниже.
# RewriteCond %{HTTPS} off
# RewriteCond %{HTTP:X-Forwarded-Proto} !https
# RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www -> без www (пока по http)
RewriteCond %{HTTP_HOST} ^www\.oknatrio\.ru$ [NC]
RewriteRule ^(.*)$ http://oknatrio.ru/$1 [L,R=301]

# ===== 301 со старого сайта (NetCat, *.php) на новые страницы. Список и пояснения: файл "redirects" =====
RewriteRule ^index\.php$ / [L,R=301]
RewriteRule ^(windows|window|antisound-windows|raskladka|saveenergy-windows|color-windows|custom-windows|accessories|usable|balcon)\.php$ /okna/pvh/ [L,R=301]
RewriteRule ^cottage\.php$ /nashi-raboty/ [L,R=301]
RewriteRule ^gallery\.php$ /nashi-raboty/ [L,R=301]
RewriteRule ^contacts\.php$ /kontakty/ [L,R=301]
RewriteRule ^(about_us|warranty)\.php$ /o-kompanii/ [L,R=301]
RewriteRule ^(reviews|services|price|credit|discounts|articles|forbuilders)\.php$ / [L,R=301]
RewriteRule ^(articles|accessories|window|catalog)/ / [L,R=301]

# Страницы «Алюминиевые окна» больше нет: есть страницы брендов
RewriteRule ^okna/alyuminievye/?$ /okna/alyuminievye/schuco/ [L,R=301]

# окнатрио.рф -> основной домен (301). TODO: подставить punycode и основной домен при деплое
# RewriteCond %{HTTP_HOST} ^(www\.)?xn--80aqemdemp\.xn--p1ai$ [NC]
# RewriteRule ^(.*)$ https://oknatrio.ru/$1 [L,R=301]

# 301 со старых URL: переносить строки из файла "redirects", например:
# Redirect 301 /plastikovye-okna/ /okna/pvh/

# ===== Безопасность =====
Options -Indexes
# служебные файлы, резервные копии и дампы наружу не отдаём
<FilesMatch "(^\.|\.(sql|bak|old|orig|swp|log|ini|env|sqlite|sqlite3|db|jsonl|md|lock)$|^(composer|package)(-lock)?\.json$)">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  # HTTPS уже включён принудительно выше; год запоминания для браузеров
  # HSTS включить ТОЛЬКО после установки SSL: Header always set Strict-Transport-Security "max-age=31536000"
  # CSP без ограничения скриптов: так не ломается Яндекс.Метрика и карта; закрыто встраивание сайта, чужие base/form и плагины
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>

# Заявки обрабатывает form-handler.php; конфиг с e-mail закрыт от прямого доступа
<Files "form-config.php">
  Require all denied
</Files>

# Сжатие и кэш статики (скорость = ранжирование)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
