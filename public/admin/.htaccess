# Админка: без индексации и без списка файлов
Options -Indexes
DirectoryIndex index.php
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
# Файлы данных и копии наружу не отдаём (дополнительно к закрытой папке _data)
<FilesMatch "\.(sqlite|sqlite3|db|jsonl|log|bak|sql)$">
  Require all denied
</FilesMatch>
# Страница «Наши работы» отправляет сотни полей (фото всех работ): поднимаем лимит PHP, иначе часть полей теряется при сохранении
<IfModule mod_php.c>
  php_value max_input_vars 5000
</IfModule>
<IfModule mod_php7.c>
  php_value max_input_vars 5000
</IfModule>
<IfModule mod_php8.c>
  php_value max_input_vars 5000
</IfModule>
